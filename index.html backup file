<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>The Winner School Attendance</title>

<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-auth-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-database-compat.js"></script>

<style>
*{box-sizing:border-box}
body{margin:0;font-family:Arial,sans-serif;background:#f1f5f9;color:#172033}
header{background:#123b70;color:white;padding:18px;text-align:center}
header h1{margin:0;font-size:23px}
header p{margin:6px 0 0}
.container{max-width:1200px;margin:auto;padding:15px}
.card{background:white;padding:16px;border-radius:14px;margin-bottom:15px;box-shadow:0 3px 12px #0001}
input,select,textarea,button{padding:11px;border-radius:8px;border:1px solid #ccc;font-size:14px;margin:4px 0}
input,select,textarea{width:100%}
button{border:0;background:#1764a5;color:white;cursor:pointer;font-weight:bold}
button:hover{opacity:.9}
.danger{background:#dc3545}
.success{background:#16844a}
.secondary{background:#64748b}
.tabs{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:15px}
.tabs button{flex:1;min-width:100px}
.hidden{display:none!important}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:10px}
.stat{background:#e8f2ff;padding:15px;border-radius:12px;text-align:center}
.stat b{display:block;font-size:25px;color:#123b70}
table{width:100%;border-collapse:collapse;min-width:600px}
th,td{padding:10px;border-bottom:1px solid #ddd;text-align:left}
th{background:#eaf2f8}
.tablewrap{overflow-x:auto}
.badge{padding:5px 8px;border-radius:6px;font-size:12px}
.present{background:#d1fae5;color:#065f46}
.absent{background:#fee2e2;color:#991b1b}
.leave{background:#fef3c7;color:#92400e}
#loginBox{max-width:420px;margin:40px auto}
h2{color:#123b70}
.small{font-size:12px;color:#64748b}
</style>
</head>

<body>

<header>
<h1>THE WINNER SCHOOL</h1>
<p>ISLAMIC CAMPUS • Attendance Management System</p>
</header>

<div class="container">

<div id="loginBox" class="card">
<h2>Staff Login</h2>
<input id="email" type="email" placeholder="Email Address">
<input id="password" type="password" placeholder="Password">
<button onclick="login()">Login</button>
<p id="loginMsg"></p>
</div>

<div id="app" class="hidden">

<div class="card">
<div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap">
<div>
<b id="welcome"></b>
<p class="small">Attendance • Students • Reports</p>
</div>
<button class="danger" onclick="logout()">Logout</button>
</div>
</div>

<div class="tabs">
<button onclick="showTab('attendance')">Attendance</button>
<button onclick="showTab('students')">Students</button>
<button onclick="showTab('reports')">Reports</button>
<button onclick="showTab('holidays')">Holidays</button>
<button id="staffTabBtn" onclick="showTab('staff')">Staff</button>
<button id="backupTabBtn" onclick="showTab('backup')">Backup</button>
</div>

<!-- ATTENDANCE -->
<section id="attendance" class="tab card">
<h2>Daily Attendance</h2>

<div class="grid">
<div>
<label>Date</label>
<input type="date" id="attDate">
</div>
<div>
<label>Class</label>
<select id="attClass" onchange="renderAttendance()"></select>
</div>
</div>

<div class="grid" style="margin-top:12px">
<div class="stat">Students<b id="totalCount">0</b></div>
<div class="stat">Present<b id="presentCount">0</b></div>
<div class="stat">Absent<b id="absentCount">0</b></div>
<div class="stat">Leave<b id="leaveCount">0</b></div>
</div>

<div class="tablewrap">
<table>
<thead><tr>
<th>Student</th><th>Roll No.</th><th>Status</th><th>Parent WhatsApp</th>
</tr></thead>
<tbody id="attendanceTable"></tbody>
</table>
</div>

<button class="success" onclick="saveAttendance()">Save Attendance</button>
<button onclick="openAbsentWhatsApp()">WhatsApp Absent Parents</button>
</section>

<!-- STUDENTS -->
<section id="students" class="tab card hidden">
<h2>Student Register</h2>

<div id="studentForm">
<input id="studentName" placeholder="Student Name">
<input id="studentRoll" placeholder="Roll Number">
<select id="studentClass"></select>
<input id="parentName" placeholder="Parent Name">
<input id="parentPhone" placeholder="Parent WhatsApp Number (923xxxxxxxxx)">
<button onclick="addStudent()">Add Student</button>
</div>

<h3>Student List</h3>
<div class="tablewrap">
<table>
<thead><tr>
<th>Name</th><th>Roll</th><th>Class</th><th>Parent</th><th>Phone</th><th>Action</th>
</tr></thead>
<tbody id="studentsTable"></tbody>
</table>
</div>
<button onclick="exportStudents()">Export Students CSV</button>
</section>

<!-- REPORTS -->
<section id="reports" class="tab card hidden">
<h2>Attendance Reports</h2>

<label>Report Type</label>
<select id="reportType">
<option value="daily">Daily Report</option>
<option value="monthly">Monthly Report</option>
</select>

<label>Date</label>
<input type="date" id="reportDate">

<label>Class</label>
<select id="reportClass"></select>

<button onclick="generateReport()">Generate Report</button>
<button onclick="exportReport()">Export Report CSV</button>

<div id="reportResults"></div>
</section>

<!-- HOLIDAYS -->
<section id="holidays" class="tab card hidden">
<h2>Holidays Management</h2>

<div id="holidayForm">
<input type="date" id="holidayDate">
<input id="holidayName" placeholder="Holiday Name">
<button onclick="addHoliday()">Add Holiday</button>
</div>

<div id="holidayList"></div>
</section>

<!-- STAFF -->
<section id="staff" class="tab card hidden">
<h2>Staff Management</h2>
<p class="small">
Staff accounts must first be created in Firebase Authentication.
Here you can assign the staff member and class.
</p>

<div id="staffForm">
<input id="staffEmail" placeholder="Staff Login Email">
<input id="staffName" placeholder="Staff Name">
<select id="staffClass"></select>
<button onclick="addStaff()">Assign Staff</button>
</div>

<div id="staffList"></div>
</section>

<!-- BACKUP -->
<section id="backup" class="tab card hidden">
<h2>Backup & Restore</h2>
<button onclick="backup()">Download JSON Backup</button>

<label style="display:block;margin-top:15px">Restore Backup</label>
<input type="file" id="restoreFile" accept=".json">
<button onclick="restoreBackup()">Restore Data</button>

<button class="danger" onclick="resetDemo()">Reset All Data</button>
</section>

</div>
</div>

<script>
// ================= FIREBASE CONFIG =================

const firebaseConfig = {
apiKey: "AIzaSyBoeVKahBPXx-sPE57nH-ylkl5c1djE",
authDomain: "the-winner-school-attendence.firebaseapp.com",
databaseURL: "https://the-winner-school-attendence-default-rtdb.asia-southeast1.firebasedatabase.app",
projectId: "the-winner-school-attendence",
storageBucket: "the-winner-school-attendence.firebasestorage.app",
messagingSenderId: "255019225232",
appId: "1:255019225232:web:2c2cbeaaabffd7899c8815",
measurementId: "G-JBQ6F69KSK"
};

firebase.initializeApp(firebaseConfig);

const auth=firebase.auth();
const db=firebase.database();

const ROOT="schoolAttendance";
const ADMIN_EMAIL="maryamsarwar041@gmail.com";

const CLASSES=[
"Nursery","Reception","Prep",
"Class 1","Class 2","Class 3",
"Class 4","Class 5","Class 6",
"Class 7","Class 8","Class 9","Class 10"
];

let currentUser=null;
let isAdmin=false;
let assignedClass="";
let data={
students:[],
records:{},
holidays:{},
staff:{}
};
let currentReport=[];

// ================= LOGIN =================

async function login(){
const e=document.getElementById("email").value.trim();
const p=document.getElementById("password").value;

try{
await auth.signInWithEmailAndPassword(e,p);
}catch(err){
document.getElementById("loginMsg").innerText=err.message;
}
}

async function logout(){
await auth.signOut();
}

auth.onAuthStateChanged(async user=>{
if(!user){
currentUser=null;
document.getElementById("loginBox").classList.remove("hidden");
document.getElementById("app").classList.add("hidden");
return;
}

currentUser=user;
isAdmin=user.email.toLowerCase()===ADMIN_EMAIL.toLowerCase();

try{
await loadData();

if(!isAdmin){
const staffInfo=data.staff[user.email];
if(!staffInfo){
alert("Your staff account has not been assigned a class. Please contact Admin.");
await auth.signOut();
return;
}
assignedClass=staffInfo.className;
}

document.getElementById("loginBox").classList.add("hidden");
document.getElementById("app").classList.remove("hidden");

document.getElementById("welcome").innerText=
isAdmin?"Welcome Admin":"Welcome "+(data.staff[user.email]?.name||user.email);

document.getElementById("staffTabBtn").classList.toggle("hidden",!isAdmin);
document.getElementById("backupTabBtn").classList.toggle("hidden",!isAdmin);
document.getElementById("studentForm").classList.toggle("hidden",!isAdmin);
document.getElementById("staffForm").classList.toggle("hidden",!isAdmin);
document.getElementById("holidayForm").classList.toggle("hidden",!isAdmin);

setupSelectors();
renderAttendance();
renderStudents();
renderHolidays();
renderStaff();

}catch(err){
alert("Data loading error: "+err.message);
}
});

// ================= DATA =================

async function loadData(){
const snap=await db.ref(ROOT).once("value");
data=snap.val()||{};

data.students=data.students||[];
data.records=data.records||{};
data.holidays=data.holidays||{};
data.staff=data.staff||{};
}

function saveData(){
return db.ref(ROOT).update(data);
}

function setupSelectors(){
const options=CLASSES.map(c=>`<option>${c}</option>`).join("");

["attClass","studentClass","reportClass","staffClass"].forEach(id=>{
document.getElementById(id).innerHTML=options;
});

if(!isAdmin){
["attClass","studentClass","reportClass"].forEach(id=>{
document.getElementById(id).value=assignedClass;
document.getElementById(id).disabled=true;
});
document.getElementById("staffClass").disabled=true;
document.getElementById("staffClass").value=assignedClass;
}

document.getElementById("attDate").value=today();
document.getElementById("reportDate").value=today();
}

function today(){
return new Date().toISOString().slice(0,10);
}

// ================= TABS =================

function showTab(name){
document.querySelectorAll(".tab").forEach(t=>t.classList.add("hidden"));
document.getElementById(name).classList.remove("hidden");

if(name==="attendance")renderAttendance();
if(name==="students")renderStudents();
if(name==="holidays")renderHolidays();
if(name==="staff")renderStaff();
}

// ================= STUDENTS =================

async function addStudent(){
if(!isAdmin)return;

const name=document.getElementById("studentName").value.trim();
const roll=document.getElementById("studentRoll").value.trim();
const cls=document.getElementById("studentClass").value;
const parent=document.getElementById("parentName").value.trim();
const phone=document.getElementById("parentPhone").value.trim();

if(!name||!roll||!cls){
alert("Please enter student name, roll number and class.");
return;
}

if(data.students.some(s=>s.roll===roll&&s.cls===cls)){
alert("This roll number already exists in this class.");
return;
}

data.students.push({
id:Date.now().toString(),
name,roll,cls,parent,phone
});

await saveData();

document.getElementById("studentName").value="";
document.getElementById("studentRoll").value="";
document.getElementById("parentName").value="";
document.getElementById("parentPhone").value="";

renderStudents();
renderAttendance();
alert("Student added successfully!");
}

function renderStudents(){
const list=data.students.filter(s=>isAdmin||s.cls===assignedClass);

document.getElementById("studentsTable").innerHTML=list.map(s=>`
<tr>
<td>${escapeHtml(s.name)}</td>
<td>${escapeHtml(s.roll)}</td>
<td>${escapeHtml(s.cls)}</td>
<td>${escapeHtml(s.parent||"")}</td>
<td>${escapeHtml(s.phone||"")}</td>
<td>${isAdmin?`
<button onclick="editStudent('${s.id}')">Edit</button>
<button class="danger" onclick="deleteStudent('${s.id}')">Delete</button>
`:"Read Only"}</td>
</tr>
`).join("");
}

async function editStudent(id){
if(!isAdmin)return;

const s=data.students.find(x=>x.id===id);
if(!s)return;

const name=prompt("Student Name",s.name);
if(name===null)return;

const roll=prompt("Roll Number",s.roll);
if(roll===null)return;

const parent=prompt("Parent Name",s.parent||"");
const phone=prompt("Parent WhatsApp Number",s.phone||"");

s.name=name.trim();
s.roll=roll.trim();
s.parent=parent||"";
s.phone=phone||"";

await saveData();
renderStudents();
renderAttendance();
}

async function deleteStudent(id){
if(!isAdmin)return;
if(!confirm("Delete this student?"))return;

data.students=data.students.filter(s=>s.id!==id);
await saveData();
renderStudents();
renderAttendance();
}

// ================= ATTENDANCE =================

function renderAttendance(){
const date=document.getElementById("attDate").value||today();
const cls=document.getElementById("attClass").value;

const students=data.students.filter(s=>s.cls===cls);
const record=data.records[date]?.[cls]||{};

let p=0,a=0,l=0;

document.getElementById("attendanceTable").innerHTML=students.map(s=>{
const status=record[s.id]||"Present";

if(status==="Present")p++;
if(status==="Absent")a++;
if(status==="Leave")l++;

return `<tr>
<td>${escapeHtml(s.name)}</td>
<td>${escapeHtml(s.roll)}</td>
<td>
<select id="status_${s.id}" onchange="updateStats()">
<option ${status==="Present"?"selected":""}>Present</option>
<option ${status==="Absent"?"selected":""}>Absent</option>
<option ${status==="Leave"?"selected":""}>Leave</option>
</select>
</td>
<td>${escapeHtml(s.phone||"")}</td>
</tr>`;
}).join("");

document.getElementById("totalCount").innerText=students.length;
document.getElementById("presentCount").innerText=p;
document.getElementById("absentCount").innerText=a;
document.getElementById("leaveCount").innerText=l;
}

function updateStats(){
const cls=document.getElementById("attClass").value;
const students=data.students.filter(s=>s.cls===cls);

let p=0,a=0,l=0;

students.forEach(s=>{
const v=document.getElementById("status_"+s.id)?.value||"Present";
if(v==="Present")p++;
if(v==="Absent")a++;
if(v==="Leave")l++;
});

document.getElementById("totalCount").innerText=students.length;
document.getElementById("presentCount").innerText=p;
document.getElementById("absentCount").innerText=a;
document.getElementById("leaveCount").innerText=l;
}

async function saveAttendance(){
const date=document.getElementById("attDate").value;
const cls=document.getElementById("attClass").value;

if(!date||!cls)return;

data.records[date]=data.records[date]||{};
data.records[date][cls]=data.records[date][cls]||{};

const students=data.students.filter(s=>s.cls===cls);

students.forEach(s=>{
const status=document.getElementById("status_"+s.id)?.value||"Present";
data.records[date][cls][s.id]=status;
});

await saveData();
alert("Attendance saved successfully!");
}

// ================= WHATSAPP =================

function openAbsentWhatsApp(){
const date=document.getElementById("attDate").value;
const cls=document.getElementById("attClass").value;

const students=data.students.filter(s=>s.cls===cls);
let count=0;

students.forEach(s=>{
const status=document.getElementById("status_"+s.id)?.value||"Present";

if(status!=="Absent"||!s.phone)return;

const phone=s.phone.replace(/\D/g,"");
const message=`Assalam-o-Alaikum Dear Parent,
Your child ${s.name} (${s.cls}) is marked ABSENT today (${date}).
Kindly ensure regular attendance.
Regards, The Winner School (Islamic Campus).`;

const url="https://wa.me/"+phone+"?text="+encodeURIComponent(message);

window.open(url,"_blank");
count++;
});

if(count===0)alert("No absent students with WhatsApp numbers found.");
}

// ================= REPORTS =================

function generateReport(){
const type=document.getElementById("reportType").value;
const date=document.getElementById("reportDate").value;
const cls=document.getElementById("reportClass").value;

currentReport=[];

if(type==="daily"){
const record=data.records[date]?.[cls]||{};

data.students.filter(s=>s.cls===cls).forEach(s=>{
currentReport.push({
date,name:s.name,roll:s.roll,cls,
status:record[s.id]||"Not Marked"
});
});

}else{
const month=date.slice(0,7);

Object.keys(data.records).filter(d=>d.startsWith(month)).sort().forEach(d=>{
const record=data.records[d]?.[cls]||{};

data.students.filter(s=>s.cls===cls).forEach(s=>{
currentReport.push({
date:d,name:s.name,roll:s.roll,cls,
status:record[s.id]||"Not Marked"
});
});
});
}

let html=`<h3>Report: ${cls}</h3>
<div class="tablewrap"><table>
<tr><th>Date</th><th>Student</th><th>Roll</th><th>Status</th></tr>`;

currentReport.forEach(r=>{
html+=`<tr>
<td>${r.date}</td>
<td>${escapeHtml(r.name)}</td>
<td>${escapeHtml(r.roll)}</td>
<td>${r.status}</td>
</tr>`;
});

html+="</table></div>";
document.getElementById("reportResults").innerHTML=html;
}

function exportReport(){
if(!currentReport.length){
alert("Please generate report first.");
return;
}

downloadCSV(currentReport,"Attendance_Report.csv");
}

// ================= HOLIDAYS =================

async function addHoliday(){
if(!isAdmin)return;

const date=document.getElementById("holidayDate").value;
const name=document.getElementById("holidayName").value.trim();

if(!date||!name){
alert("Enter holiday date and name.");
return;
}

data.holidays[date]=name;
await saveData();

document.getElementById("holidayName").value="";
renderHolidays();
}

function renderHolidays(){
const list=Object.entries(data.holidays||{}).sort();

document.getElementById("holidayList").innerHTML=list.map(([date,name])=>`
<div class="card">
<b>${date}</b> - ${escapeHtml(name)}
${isAdmin?`<button class="danger" onclick="deleteHoliday('${date}')">Delete</button>`:""}
</div>`).join("");
}

async function deleteHoliday(date){
if(!isAdmin)return;
if(!confirm("Delete this holiday?"))return;
delete data.holidays[date];
await saveData();
renderHolidays();
}

// ================= STAFF =================

async function addStaff(){
if(!isAdmin)return;

const email=document.getElementById("staffEmail").value.trim().toLowerCase();
const name=document.getElementById("staffName").value.trim();
const cls=document.getElementById("staffClass").value;

if(!email||!name||!cls){
alert("Please complete staff information.");
return;
}

data.staff[email]={name,className:cls};
await saveData();

document.getElementById("staffEmail").value="";
document.getElementById("staffName").value="";

renderStaff();
alert("Staff class assignment saved.");
}

function renderStaff(){
const entries=Object.entries(data.staff||{});

document.getElementById("staffList").innerHTML=entries.map(([email,s])=>`
<div class="card">
<b>${escapeHtml(s.name)}</b><br>
${escapeHtml(email)}<br>
Class: ${escapeHtml(s.className)}
${isAdmin?`<button class="danger" onclick="deleteStaff('${encodeURIComponent(email)}')">Remove</button>`:""}
</div>`).join("");
}

async function deleteStaff(encodedEmail){
if(!isAdmin)return;
const email=decodeURIComponent(encodedEmail);

if(!confirm("Remove this staff assignment?"))return;

delete data.staff[email];
await saveData();
renderStaff();
}

// ================= EXPORT =================

function exportStudents(){
downloadCSV(data.students,"Students.csv");
}

function downloadCSV(rows,filename){
if(!rows||!rows.length){
alert("No data available.");
return;
}

const keys=Object.keys(rows[0]);

const csv=[
keys.join(","),
...rows.map(row=>keys.map(k=>
`"${String(row[k]??"").replace(/"/g,'""')}"`
).join(","))
].join("\n");

const blob=new Blob(["\uFEFF"+csv],{type:"text/csv;charset=utf-8"});
const a=document.createElement("a");
a.href=URL.createObjectURL(blob);
a.download=filename;
a.click();
URL.revokeObjectURL(a.href);
}

// ================= BACKUP =================

function backup(){
if(!isAdmin)return;

const blob=new Blob([JSON.stringify(data,null,2)],{type:"application/json"});
const a=document.createElement("a");
a.href=URL.createObjectURL(blob);
a.download="winner-school-backup.json";
a.click();
}

function restoreBackup(){
if(!isAdmin)return;

const file=d
